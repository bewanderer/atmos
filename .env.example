# Copy to .env and fill in. Never commit .env.

# Postgres. The app connects as atmos_ingest or atmos_api, never as the owner.
ATMOS_DATABASE_URL=postgresql://atmos_ingest:changeme@localhost:5432/atmos

# Raw archive. S3 compatible, normally Cloudflare R2.
# This credential should be able to put and read objects, but not delete them.
ATMOS_ARCHIVE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
ATMOS_ARCHIVE_BUCKET=atmos-raw
ATMOS_ARCHIVE_ACCESS_KEY=
ATMOS_ARCHIVE_SECRET_KEY=

# Politeness. Raise the interval rather than lower it if a source looks strained.
ATMOS_MIN_INTERVAL_S=2.0
ATMOS_REQUEST_TIMEOUT_S=30.0
